# Required: create a Telegram bot with @BotFather and paste its token here.
TELOXIDE_TOKEN=your_telegram_bot_token

# Price fluctuation monitoring
FLUCT_THRESHOLD=1.5
WINDOW_MINUTES=5
CHECK_INTERVAL_SEC=60
ALERT_COOLDOWN_SEC=900
CONFIRM_TICKS=2
MAX_JUMP_PCT=15.0

# SQLite database file
DB_PATH=users.db

# Optional network configuration
# Used only for Telegram traffic (for example: socks5h://127.0.0.1:10808)
TELEGRAM_PROXY=

# Used only for price-source website requests
SITES_PROXY=

# Optional alternative Telegram Bot API base URL
TELEGRAM_API_URL=

# Optional logging level
RUST_LOG=info
